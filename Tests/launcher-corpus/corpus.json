 "cases": [
  {
   "query": "safari",
   "expect": "com.apple.Safari",
   "criterion": "display name, exact"
  },
  {
   "query": "chrome",
   "expect": "com.google.Chrome",
   "criterion": "display name, word start"
  },
  {
   "query": "浏览器",
   "expect": "com.apple.Safari",
   "criterion": "an alternate in its own script"
  },
  {
   "query": "llq",
   "expect": "com.apple.Safari",
   "criterion": "pinyin initials of a non-Latin alternate"
  },
  {
   "query": "ical",
   "expect": "com.apple.Calendar",
   "criterion": "a vendor's old name for itself"
  },
  {
   "query": "codex",
   "expect": "com.openai.chat",
   "criterion": "an alternate that is nobody's display name"
  },
  {
   "query": "微信",
   "expect": "com.tencent.xinWeChat",
   "criterion": "a Chinese display name typed in Chinese"
  },
  {
   "query": "weixin",
   "expect": "com.tencent.xinWeChat",
   "criterion": "…typed as pinyin"
  },
  {
   "query": "wx",
   "expect": "com.tencent.xinWeChat",
   "criterion": "…typed as pinyin initials"
  },
  {
   "query": "wangyiyunyinle",
   "expect": "com.netease.163music",
   "criterion": "a longer pinyin reading"
  },
  {
   "query": "wyyyl",
   "expect": "com.netease.163music",
   "criterion": "…and its initials"
  },
  {
   "query": "telegram",
   "expect": "org.telegram.desktop",
   "criterion": "a Cyrillic display name typed in Latin"
  },
  {
   "query": "cafe",
   "expect": "com.example.cafenoir",
   "criterion": "an accented name typed without the accent"
  },
  {
   "query": "ｃａｆｅ",
   "expect": "com.example.cafenoir",
   "criterion": "…and in full-width characters"
  },
  {
   "query": "work chat",
   "expect": "com.tinyspeck.slackmacgap",
   "criterion": "a renamed bundle, by the name on disk"
  },
  {
   "query": "slack",
   "expect": "com.tinyspeck.slackmacgap",
   "criterion": "…which never displaces its real display name"
  },
  {
   "query": "electron",
   "expect": "com.microsoft.VSCode",
   "criterion": "the executable name"
  },
  {
   "query": "com.apple.Photos",
   "expect": "com.apple.Photos",
   "criterion": "a pasted bundle identifier"
  },
  {
   "query": "sig",
   "expect": "snippet:signature",
   "criterion": "a snippet's keyword"
  },
  {
   "query": "zed",
   "expect": "extension:zed/recent",
   "criterion": "the owning extension's title — reachable only by using it"
  },
  {
   "query": "lucide",
   "expect": "extension:lucide/index",
   "criterion": "an owner title shared by every command it ships"
  },
  {
   "query": "almost",
   "expect": "window-command:almost-maximize",
   "criterion": "a window command"
  },
  {
   "query": "set",
   "expect": "system-action:set-volume",
   "criterion": "a short name against a longer rival"
  },
  {
   "query": "calc",
   "expect": "command:calculator-history",
   "criterion": "a command losing cold to an app, winnable by use"
  },
  {
   "query": "notes",
   "expect": "command:show-notes",
   "criterion": "an app named exactly the query",
   "protected": true,
   "note": "Notes.app is named exactly 'notes'; P1 protects an exact name hit. Escape: a user alias."
  },
  {
   "query": "search",
   "expect": "command:search-notes",
   "criterion": "several commands share the whole query as a prefix"
  }
 ]
}
