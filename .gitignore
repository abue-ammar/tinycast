# macOS
.DS_Store

# Xcode
DerivedData/
*.xcworkspace/xcuserdata/
*.xcuserdatad/
*.xcuserstate

# User-specific project settings
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# SourceKit-LSP / Swift tooling (machine-specific, generated by xcode-build-server)
buildServer.json
.compile
.swiftpm/
.build/

# Build output
build/
dist/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Code coverage
*.profdata
*.xccovarchive
*.xccovreport

# CocoaPods (if ever added)
Pods/

# Carthage (if ever added)
Carthage/Build/

# Mint (if ever added)
.mint/

# Tuist (if ever added)
Tuist/.build/

# Extension runtime toolchain (Scripts/raycast-runtime)
node_modules/

# Temporary files
*.swp
*.tmp
*.orig
# Website (Next.js). `out/` is the static export, `.source/` is generated from
# content/docs by fumadocs-mdx on install and build, `.wrangler/` is local deploy state.
website/.next/
website/out/
website/.source/
website/.wrangler/
# `next dev` and `next build` each rewrite it to point at their own types directory.
website/next-env.d.ts
# Staging for `npm run upload-media`; the R2 bucket behind cdn.tinycast.dev is the only copy.
website/media/

# Real Raycast exports carry the author's clipboard history; the harness builds its own fixtures.
*.rayconfig
# Generated by `wrangler types` on install; `.dev.vars` holds local Polar secrets.
website/worker/worker-configuration.d.ts
website/.dev.vars
