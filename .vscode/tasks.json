{
  "version": "2.0.0",
  "tasks": [
    {
      // Build the .app with xcodebuild into a fixed path (build/DerivedData) so the app
      // location is stable — that's what lets F5 find it and keeps the Accessibility grant.
      // DEVELOPER_DIR forces Xcode's toolchain (the SwiftUI macros aren't in the CLT).
      // The build log is piped to `xcode-build-server parse` so SourceKit-LSP's flag
      // database (.compile) stays in sync on every build — that's what keeps cross-file
      // symbols resolving in VS Code as you add/rename files. pipefail preserves the
      // xcodebuild exit code so a failed build still blocks F5 / the run step.
      "label": "Build Smallcast.app (debug)",
      "type": "shell",
      "command": "bash -c 'set -o pipefail; xcodebuild -project Smallcast.xcodeproj -scheme Smallcast -configuration Debug -derivedDataPath build/DerivedData build 2>&1 | tee \"${TMPDIR:-/tmp}/smallcast-build.log\"; ec=$?; /opt/homebrew/bin/xcode-build-server parse -a -o .compile < \"${TMPDIR:-/tmp}/smallcast-build.log\" >/dev/null 2>&1 || true; exit $ec'",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer" }
      },
      "group": "build",
      "problemMatcher": ["$swiftc"]
    },
    {
      // Rebuild, then relaunch the menu-bar app. Default build task (⌘⇧B).
      "label": "Build & Run Smallcast (debug)",
      "type": "shell",
      "command": "killall 'Smallcast Dev' 2>/dev/null; open 'build/DerivedData/Build/Products/Debug/Smallcast Dev.app'",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build Smallcast.app (debug)",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
