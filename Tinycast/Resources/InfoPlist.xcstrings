{
  "sourceLanguage": "en",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast uses automation to perform system actions you explicitly run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 使用自动化来执行你主动运行的系统操作。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast shows a camera preview so you can check yourself, and take a photo to the clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 显示摄像头预览，方便你检查画面，并将拍摄的照片复制到剪贴板。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast reads today's and tomorrow's events so you can join a meeting from the palette."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 读取今天和明天的日程，方便你从面板加入会议。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast uses Bluetooth access only when you run the Toggle Bluetooth action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinycast 仅在你运行「切换蓝牙」操作时使用蓝牙权限。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
