+                .overlay { shape.fill(Theme.Colors.glassFrost) }
+                .overlay { shape.stroke(Theme.Colors.border.opacity(0.6), lineWidth: 0.5) }
+                .shadow(color: .black.opacity(0.22), radius: 6, y: 2)
+        }
+    }
+}
