+private struct FrostedSurface<S: Shape>: ViewModifier {
+    let shape: S
+    /// Interactive glass lenses under the cursor — right for the tappable pill and circle, wrong for a menu panel.
+    let isInteractive: Bool
+
+    @ViewBuilder
+    func body(content: Content) -> some View {
+        if #available(macOS 26.0, *) {
+            // `.tint(.clear)` only neutralizes glass tint inheritance, so it belongs on this branch alone.
+            if isInteractive {
+                content
+                    .glassEffect(.regular.interactive().tint(Theme.Colors.glassFrost), in: shape)
+                    .tint(.clear)
+            } else {
+                content.glassEffect(.regular, in: shape)
+            }
+        } else {
+            fallback(content)
+        }
+    }
+
+    /// Sequoia has no glass, so the elevation glass carries for free has to be drawn back by hand.
+    private func fallback(_ content: Content) -> some View {
